      "id": "unseen",
      "type": "callout",
      "category": "files",
      "label": "Why the scan stays hidden",
      "props": {
        "tone": "warn",
        "title": "Invisible to both searches",
        "md": "**By name:** `scan0042.pdf` says nothing about Acme.\n\n**By contents:** a scan is a picture of words, so grep has no letters to match."
      },
      "at": {
        "x": 880,
        "y": 200,
        "w": 320
      }
    },
    {
      "id": "try",
      "type": "try-it",
      "props": {
        "title": "Watch Claude search",
        "ask": "Which files in this folder mention invoices? Tell me how you searched.",
        "expect": "Run it in a folder of your own. In its steps you'll usually see `find` and `grep`: on a Mac, that is how Claude Code searches."
      },
      "at": {
        "x": 880,
        "y": 420,
        "w": 320
      }
    }
