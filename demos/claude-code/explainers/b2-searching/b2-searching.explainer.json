      "id": "you",
      "type": "chat-turn",
      "category": "you",
      "label": "Your question",
      "props": {
        "who": "you",
        "text": "What does the Acme contract say about late fees?"
      },
      "at": {
        "x": 420,
        "y": 0,
        "w": 420
      }
    },
    {
      "id": "term",
      "type": "terminal",
      "category": "tools",
      "label": "Claude's searches",
      "props": {
        "title": "Terminal — zsh",
        "badge": "run by Claude",
        "prompt": "~/Work %",
        "lines": [
          {
            "kind": "cmd",
            "text": "find . -iname \"*acme*\""
          },
          {
            "kind": "out",
            "text": "./Clients/Acme"
          },
          {
            "kind": "out",
            "text": "./Clients/Acme/Acme-contract-2026.pdf",
