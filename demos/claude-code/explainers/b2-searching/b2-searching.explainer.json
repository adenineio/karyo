  "steps": [
    {
      "id": "s1",
      "title": "It can't see your folders",
      "text": "You take in this folder at a glance. Claude can't: about your files, it knows only what it has read. So it works like a librarian, searching the catalogue instead of reading every book.",
      "show": [
        "tree",
        "librarian"
      ],
      "emphasize": [
        "tree"
      ]
    },
    {
      "id": "s2",
      "title": "You ask about a thing",
      "text": "Your question names a thing, *the Acme contract*, not a file. Claude has to work out which of these eight files hold the answer.",
      "add": [
        "you"
      ],
      "emphasize": [
        "you"
      ],
      "dim": [
        "librarian"
      ]
    },
    {
      "id": "s3",
      "title": "Search by name",
      "text": "First the titles. `find` lists everything whose **name** contains *acme*, in capitals or not (`-iname`). One hit is the contract itself.",
      "add": [
        "term"
      ],
      "emphasize": [
        "term",
        "tree"
      ],
      "dim": [
        "you",
        "librarian"
      ],
      "set": {
        "tree": {
          "title": "~/Work",
          "items": [
            {
              "name": "Clients",
              "depth": 0,
              "kind": "folder"
            },
            {
              "name": "Acme",
              "depth": 1,
              "kind": "folder",
              "state": "hit"
            },
            {
              "name": "Acme-contract-2026.pdf",
              "depth": 2,
              "kind": "file",
              "state": "hit",
              "note": "name"
            },
            {
              "name": "kickoff-notes.md",
              "depth": 2,
              "kind": "file"
            },
            {
              "name": "Birch",
              "depth": 1,
              "kind": "folder"
            },
            {
              "name": "proposal.md",
              "depth": 2,
              "kind": "file"
            },
            {
              "name": "Finance",
              "depth": 0,
              "kind": "folder"
            },
            {
              "name": "budget-2026.csv",
              "depth": 1,
              "kind": "file"
            },
            {
              "name": "invoices-2026.csv",
              "depth": 1,
              "kind": "file"
            },
            {
              "name": "Meetings",
              "depth": 0,
              "kind": "folder"
            },
            {
              "name": "2026-03-02-call.md",
              "depth": 1,
              "kind": "file"
            },
            {
              "name": "2026-03-09-sync.md",
              "depth": 1,
              "kind": "file"
            },
            {
              "name": "Scans",
              "depth": 0,
              "kind": "folder"
            },
            {
              "name": "scan0042.pdf",
              "depth": 1,
              "kind": "file"
            }
          ]
        }
      }
    },
    {
      "id": "s4",
      "title": "Search by contents",
      "text": "Then the index. `grep` looks **inside** every file in every folder (`-r`), ignores capitals (`-i`) and lists just the file names (`-l`). Three more files mention Acme, though their names don't.",
      "emphasize": [
        "term",
        "tree"
      ],
      "dim": [
        "you",
        "librarian"
      ],
      "set": {
        "tree": {
          "title": "~/Work",
