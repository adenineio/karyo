    {
      "id": "s6",
      "title": "The file nobody finds",
      "text": "In April the fee went up, and the signed amendment is `scan0042.pdf`. Neither search can reach it, so Claude never opens it. Its answer is confident and out of date: about your files, it knows only what it read.",
      "add": [
        "unseen"
      ],
      "emphasize": [
        "unseen",
        "tree"
      ],
      "dim": [
        "term",
        "you",
        "librarian",
        "claude"
      ],
      "set": {
        "tree": {
          "title": "~/Work",
          "items": [
            {
              "name": "Clients",
              "depth": 0,
              "kind": "folder",
              "state": "dim"
            },
            {
              "name": "Acme",
              "depth": 1,
              "kind": "folder"
            },
            {
              "name": "Acme-contract-2026.pdf",
              "depth": 2,
