    {
      "id": "s8",
      "title": "The whole picture",
      "text": "The searches are exact and repeatable; choosing what to search for, and what to open, is Claude's judgment. Name files for what they are and use the same words for the same things, and both work better.",
      "show": "*",
      "emphasize": [
        "try"
      ]
    }
