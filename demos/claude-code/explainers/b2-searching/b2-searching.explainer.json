      "id": "claude",
      "type": "chat-turn",
      "category": "claude",
      "label": "Claude's answer",
      "props": {
        "who": "claude",
        "text": "The contract sets a late fee of **2% a month**, and the 2 March call kept it at 2%.",
        "actions": [
          "Bash: find . -iname \"*acme*\"",
          "Bash: grep -ril \"acme\" .",
          "Read: Clients/Acme/Acme-contract-2026.pdf",
          "Read: Meetings/2026-03-02-call.md"
        ]
      },
      "at": {
        "x": 420,
        "y": 365,
        "w": 420
      }
    },
    {
      "id": "librarian",
      "type": "card",
      "category": "claude",
      "label": "The librarian analogy",
      "props": {
        "kicker": "Like a librarian",
        "title": "Search the catalogue, pull a few books",
        "body": "Titles first (file names), then an index of what's inside (the words in each file). Only a few books leave the shelf."
      },
      "at": {
        "x": 0,
        "y": 455,
        "w": 380
      }
    },
