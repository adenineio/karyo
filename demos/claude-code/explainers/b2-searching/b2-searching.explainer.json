{
  "karyo": "explainer/1",
  "id": "b2-searching",
  "title": "Claude searches, it doesn't see",
  "summary": "Claude can't glance at your folders. It finds files by name and by the words inside them, then opens only a few. Good names and words light the way.",
  "note": "Names, companies and files here are **made-up examples**.",
  "narration": "side",
  "uses": [
    "file-tree",
    "terminal",
    "chat-turn",
    "try-it"
  ],
  "layout": {
    "kind": "free"
  },
  "categories": [
    {
      "id": "files",
      "label": "your files"
    },
    {
      "id": "tools",
      "label": "search commands"
    },
    {
      "id": "claude",
      "label": "Claude"
    },
    {
      "id": "you",
      "label": "you"
    }
  ],
  "elements": [
