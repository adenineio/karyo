    {
      "id": "s7",
      "title": "Good names light the way",
      "text": "Rename the scan to say what it is, and the same `find` turns it up. There's no index built in advance: Claude searches fresh every time, so your names and words are the catalogue.",
      "emphasize": [
        "term",
        "tree",
        "librarian"
      ],
      "dim": [
        "you",
        "claude",
        "unseen"
      ],
      "set": {
        "tree": {
          "title": "~/Work",
          "items": [
            {
              "name": "Clients",
              "depth": 0,
              "kind": "folder"
            },
            {
              "name": "Acme",
              "depth": 1,
              "kind": "folder",
              "state": "hit"
            },
            {
              "name": "Acme-contract-2026.pdf",
              "depth": 2,
              "kind": "file",
              "state": "hit",
              "note": "name"
            },
            {
              "name": "kickoff-notes.md",
              "depth": 2,
              "kind": "file"
            },
            {
              "name": "Birch",
              "depth": 1,
              "kind": "folder"
            },
            {
              "name": "proposal.md",
              "depth": 2,
              "kind": "file"
            },
            {
              "name": "Finance",
              "depth": 0,
