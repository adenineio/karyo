    },
    {
      "id": "s8",
      "title": "Where Claude Code starts",
      "text": "Claude Code has a “you are here” too: the folder you start it in. It works in that folder and the ones inside it, and reaches files elsewhere only with your permission, so start it in the right place.",
      "show": "*",
      "emphasize": [
        "claude"
      ]
    }
  ]
}
