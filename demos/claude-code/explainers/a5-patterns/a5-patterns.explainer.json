    {
      "id": "s4",
      "title": "Describe the shape",
      "text": "A **regular expression** (regex) describes the shape of text, like describing a suspect instead of naming them. `INV-[0-9]{5}` is *INV-, then five digits*: the typo doesn't fit. *INV-99999* does, though it's only a test: a pattern knows shapes, not meaning.",
      "add": [
        "warn"
      ],
      "emphasize": [
        "parts",
        "page",
        "warn"
      ],
      "dim": [
        "tree"
      ],
      "set": {
        "term": {
          "lines": [
            {
              "kind": "cmd",
              "text": "grep -oE \"INV-[0-9]{5}\" inbox.txt"
            },
            {
              "kind": "out",
              "text": "INV-20417",
              "mark": true
            },
            {
              "kind": "out",
              "text": "INV-20418",
              "mark": true
            },
            {
              "kind": "out",
              "text": "INV-99999",
              "mark": true
            }
          ]
        },
        "parts": {
          "title": "A regular expression",
          "parts": [
            {
              "text": "INV-",
              "label": "exactly INV-",
              "tone": "exact"
            },
            {
              "text": "[0-9]",
              "label": "any one digit",
              "tone": "wild"
            },
            {
              "text": "{5}",
              "label": "five of them",
              "tone": "how"
            }
          ],
          "gloss": "`-E` lets grep read the `{5}`; `-o` prints only the matching part. Two more pieces: `.` is any one character, `^` the start of a line."
        },
        "page": {
          "lines": [
            {
              "parts": [
                {
                  "t": "From: dana.lee@example.com"
                }
              ],
              "state": "dim"
            },
            {
              "parts": [
                {
                  "t": "Invoice "
                },
                {
                  "t": "INV-20417",
                  "mark": "hit"
                },
                {
                  "t": " paid on 2026-03-14."
                }
              ],
              "state": "lit"
            },
            {
              "parts": [
                {
                  "t": "Please resend "
                },
                {
                  "t": "INV-20418",
                  "mark": "hit"
                },
                {
                  "t": "; the PDF was blank."
                }
              ],
              "state": "lit"
            },
            {
              "parts": [
                {
                  "t": "Globex says "
                },
                {
                  "t": "INV-2042",
                  "mark": "miss"
                },
                {
                  "t": " is still open."
                }
              ],
              "state": "dim"
            },
            {
              "parts": [
                {
                  "t": "Attached: sales.csv and orders.csv."
                }
              ],
              "state": "dim"
            },
            {
              "parts": [
                {
                  "t": "Next payment run: 2026/03/20."
                }
              ],
              "state": "dim"
            },
            {
              "parts": [
                {
                  "t": "Note: "
                },
                {
                  "t": "INV-99999",
                  "mark": "hit"
                },
                {
                  "t": " is only a test number."
                }
              ],
              "state": "lit"
            }
          ],
          "note": "3 matches"
        }
      }
