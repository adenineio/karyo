            },
            {
              "parts": [
                {
                  "t": "Send "
                },
                {
                  "t": "Acme Corp",
                  "mark": "hit"
                },
                {
                  "t": " the Q3 report."
                }
              ],
              "state": "lit"
            },
            {
              "parts": [
                {
