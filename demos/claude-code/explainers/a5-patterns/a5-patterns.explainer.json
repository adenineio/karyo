                }
              ],
              "state": "dim"
            }
          ],
          "note": "2 to swap"
        }
      }
    },
    {
      "id": "s7",
      "title": "awk picks columns",
      "text": "`awk` reads each line as columns. `-F,` says commas separate them and `{print $2}` prints the second: the customer. The header line comes out too, because it's a line like any other.",
      "emphasize": [
        "term",
        "page",
        "parts"
      ],
      "dim": [
        "tree",
        "warn"
      ],
      "set": {
        "term": {
          "lines": [
            {
              "kind": "cmd",
              "text": "awk -F, '{print $2}' sales.csv"
            },
            {
              "kind": "out",
              "text": "customer"
            },
            {
              "kind": "out",
              "text": "Acme",
              "mark": true
            },
