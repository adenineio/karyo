    {
      "id": "s3",
      "title": "Exact text falls short",
      "text": "Globs match file names. To search the text *inside* a file you use grep, and exact text isn't enough: one invoice number finds one line, and *INV* also finds *INV-2042*, a typo with four digits.",
      "add": [
        "page"
      ],
      "emphasize": [
        "page",
        "term"
      ],
      "dim": [
        "tree",
        "parts"
      ],
      "set": {
        "term": {
          "lines": [
            {
              "kind": "cmd",
              "text": "grep \"INV-20417\" inbox.txt"
            },
            {
              "kind": "out",
              "text": "Invoice INV-20417 paid on 2026-03-14."
            },
            {
              "kind": "cmd",
              "text": "grep \"INV\" inbox.txt"
            },
            {
              "kind": "out",
              "text": "Invoice INV-20417 paid on 2026-03-14."
            },
            {
              "kind": "out",
              "text": "Please resend INV-20418; the PDF was blank."
            },
            {
              "kind": "out",
              "text": "Globex says INV-2042 is still open.",
              "mark": true
            },
            {
              "kind": "out",
              "text": "Note: INV-99999 is only a test number."
            }
          ]
        },
        "tree": {
          "items": [
            {
              "name": "Documents",
              "kind": "folder",
              "depth": 0,
              "state": "here",
              "note": "you are here"
            },
