  "steps": [
    {
      "id": "s1",
      "title": "Wildcards: * and ?",
      "text": "The pattern most people know: in a file name, `*` means *any characters*. `ls *.csv` lists every CSV and `ls Q3*` everything starting with Q3; `?` stands for exactly one character. This kind of pattern is a **glob**.",
      "show": [
        "tree",
        "term",
        "parts"
      ],
      "emphasize": [
        "term",
        "parts"
      ],
      "set": {
        "tree": {
          "items": [
            {
              "name": "Documents",
              "kind": "folder",
              "depth": 0,
              "state": "here",
              "note": "you are here"
            },
            {
              "name": "inbox.txt",
              "kind": "file",
              "depth": 1
            },
            {
              "name": "notes.txt",
              "kind": "file",
              "depth": 1
            },
            {
              "name": "orders.csv",
              "kind": "file",
              "depth": 1,
              "state": "hit",
              "note": "*.csv"
            },
            {
              "name": "Q3-notes.txt",
              "kind": "file",
              "depth": 1,
              "state": "hit",
              "note": "Q3*  Q?-*.txt"
            },
            {
              "name": "Q3-report.docx",
              "kind": "file",
              "depth": 1,
              "state": "hit",
              "note": "Q3*"
            },
            {
              "name": "Q4-plan.txt",
              "kind": "file",
              "depth": 1,
              "state": "hit",
              "note": "Q?-*.txt"
            },
            {
              "name": "sales.csv",
              "kind": "file",
              "depth": 1,
              "state": "hit",
              "note": "*.csv"
            }
          ]
        }
      }
    },
    {
      "id": "s2",
      "title": "The shell fills in the names",
      "text": "zsh, the shell, expands the glob *before* the command runs, so `ls` only ever sees the matching names. That's why it works with almost any command. When nothing matches, zsh stops with *no matches found* (bash would pass `*.pdf` on unchanged).",
      "emphasize": [
        "term",
        "parts",
        "tree"
      ],
      "set": {
        "term": {
          "lines": [
            {
              "kind": "cmd",
              "text": "echo *.csv"
            },
            {
              "kind": "out",
              "text": "orders.csv sales.csv",
              "mark": true
            },
            {
              "kind": "cmd",
              "text": "grep -l Acme *.txt"
            },
            {
              "kind": "out",
              "text": "notes.txt"
            },
            {
              "kind": "out",
              "text": "Q3-notes.txt"
            },
            {
              "kind": "cmd",
              "text": "ls *.pdf"
            },
            {
              "kind": "err",
              "text": "zsh: no matches found: *.pdf"
            }
          ]
        },
        "tree": {
          "items": [
            {
              "name": "Documents",
              "kind": "folder",
              "depth": 0,
              "state": "here",
              "note": "you are here"
            },
            {
              "name": "inbox.txt",
              "kind": "file",
              "depth": 1,
              "state": "hit",
              "note": "*.txt"
            },
            {
