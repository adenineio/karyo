              "kind": "file",
              "depth": 1
            },
            {
              "name": "Q3-report.docx",
              "kind": "file",
              "depth": 1
            },
            {
              "name": "Q4-plan.txt",
              "kind": "file",
              "depth": 1
            },
            {
              "name": "sales.csv",
              "kind": "file",
              "depth": 1
            }
          ]
