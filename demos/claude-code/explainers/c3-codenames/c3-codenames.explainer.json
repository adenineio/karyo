      "id": "shop-tree",
      "type": "file-tree",
      "category": "shop",
      "label": "The shop's files",
      "props": {
        "title": "The shop: what you're building",
        "items": [
          {
            "name": "README.md"
          },
          {
            "name": "orders",
            "kind": "folder"
          },
          {
            "name": "run.py",
