{
  "karyo": "explainer/1",
  "id": "c3-codenames",
  "title": "Codenames: one name per thing",
  "summary": "Words leak between what you build and the machinery you build it with. One name per thing, and a codename for the machinery, keeps Claude (and grep) from mixing them up.",
  "note": "Names, companies and files here are **made-up examples**.",
  "narration": "side",
  "uses": [
    "file-tree",
    "chat-turn",
    "terminal",
    "try-it"
  ],
  "layout": {
    "kind": "free"
  },
  "categories": [
    {
      "id": "you",
      "label": "you"
    },
    {
      "id": "computer",
      "label": "the computer"
    },
    {
      "id": "shop",
      "label": "the shop (what you build)"
    },
    {
      "id": "workshop",
      "label": "your workshop (machinery)"
    }
  ],
  "elements": [
