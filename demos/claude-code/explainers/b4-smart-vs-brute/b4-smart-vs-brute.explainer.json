{
  "karyo": "explainer/1",
  "id": "b4-smart-vs-brute",
  "title": "Working smart vs brute force",
  "summary": "The same question can cost a whole desk or a few lines. Let exact tools do the finding and counting; let Claude do the judgment and the writing.",
  "note": "Names, companies and files here are **made-up examples**.",
  "narration": "side",
  "uses": [
    "file-grid",
    "context-meter",
    "chat-turn",
    "terminal",
    "try-it"
  ],
  "layout": {
    "kind": "free"
  },
  "categories": [
    {
      "id": "files",
      "label": "your files"
    },
    {
      "id": "desk",
      "label": "the context window"
    },
    {
      "id": "claude",
      "label": "Claude"
    },
    {
      "id": "tools",
      "label": "exact tools"
    },
    {
      "id": "you",
      "label": "you"
    }
  ],
  "elements": [
    {
      "id": "task",
      "type": "chat-turn",
      "category": "you",
      "label": "The task",
      "props": {
        "who": "you",
        "text": "Find every invoice over **$10,000** in these 500 CSV files."
      },
      "at": {
        "x": 0,
        "y": 0,
        "w": 380
      }
    },
    {
      "id": "grid",
      "type": "file-grid",
      "category": "files",
      "label": "The 500 invoice files",
