      },
      "at": {
        "x": 0,
        "y": 100,
        "w": 380
      }
    },
    {
      "id": "analogy",
      "type": "card",
      "category": "claude",
      "label": "The archive analogy",
      "props": {
        "kicker": "Like an archive",
        "title": "Photocopy it all, or ask the clerk",
        "body": "Brute force copies every page onto your desk to look through. The clerk follows the filing rules and hands you only the pages that match. **Where it stops:** the clerk follows rules exactly but can't judge what the pages mean."
      },
      "at": {
        "x": 0,
        "y": 565,
        "w": 380
      }
    },
    {
      "id": "meterB",
      "type": "context-meter",
