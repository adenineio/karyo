            "kind": "out",
            "text": "INV-24973 Acme 12450.00 unpaid"
          },
          {
            "kind": "out",
            "text": "INV-27542 Granite Labs 18200.00 paid"
          },
          {
            "kind": "out",
            "text": "INV-28575 Acme 10640.00 unpaid"
          },
          {
            "kind": "out",
            "text": "INV-38657 Harbor Health 24900.00 paid"
          },
          {
            "kind": "out",
            "text": "INV-39651 Corvid Ltd 11075.50 paid"
          },
          {
            "kind": "out",
            "text": "INV-41421 Acme 15300.00 paid"
          },
          {
            "kind": "note",
            "text": "(… 8 more: 14 lines in all)"
          }
        ]
      },
      "at": {
        "x": 840,
        "y": 0,
        "w": 400
