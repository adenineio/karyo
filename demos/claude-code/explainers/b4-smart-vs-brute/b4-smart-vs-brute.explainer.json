      "at": {
        "x": 420,
        "y": 0,
        "w": 380
      }
    },
    {
      "id": "claude",
      "type": "chat-turn",
      "category": "claude",
      "label": "Claude at work",
      "props": {
        "who": "claude",
        "name": "Claude, brute force",
        "text": "Reading file **350** of 500…",
        "actions": [
          "Read: invoices/2025-01-01.csv",
          "Read: invoices/2025-01-02.csv",
          "Read: invoices/2025-01-03.csv",
          "… one file at a time"
        ]
      },
      "at": {
        "x": 420,
        "y": 205,
        "w": 380
      }
    },
    {
      "id": "table",
      "type": "table",
      "label": "Brute force and smart, side by side",
      "props": {
        "columns": [
          "",
          "Brute force",
          "Smart"
        ],
        "rows": [
          [
            "Tokens",
            "≈ 1.1 million",
            "≈ 160"
          ],
          [
            "Files Claude opens",
            "500",
            "none"
          ],
          [
            "Gets all 14",
            "very likely",
            "every time"
          ],
          [
            "Run it again",
            "may differ",
            "same result"
          ]
        ],
        "caption": "Rough estimates at about 3½ characters per token: illustrative, not measured."
      },
      "at": {
        "x": 420,
        "y": 420,
        "w": 380
      }
    },
    {
      "id": "term",
      "type": "terminal",
      "category": "tools",
      "label": "One awk command",
      "props": {
        "title": "Terminal — zsh",
        "badge": "run by Claude",
        "prompt": "~/Acme %",
        "lines": [
          {
            "kind": "cmd",
            "text": "awk -F, 'FNR>1 && $6>10000 {print $1, $3, $6, $7}' invoices/*.csv"
          },
