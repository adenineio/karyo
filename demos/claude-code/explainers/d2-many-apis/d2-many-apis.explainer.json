  "steps": [
    {
      "id": "s1",
      "title": "Three systems, three tools",
      "text": "Your account brief needs three systems: the CRM, the reporting tool and the document store. Here each one offers a **thin tool**: one tool per API call, like phoning the airline, the hotel and the car hire yourself.",
      "show": [
        "you",
        "claude",
        "t1",
        "t2",
        "t3"
      ],
      "connect": [],
      "emphasize": [
        "t1",
        "t2",
        "t3"
      ]
    },
    {
      "id": "s2",
      "title": "Claude chains three calls",
      "text": "Claude calls each tool in turn, carrying the account number from the first reply into the second. Every reply comes back raw, every field the API has, and lands on the desk. Three choices, each very likely right, none guaranteed.",
      "add": [
        "meter"
      ],
      "connect": [
        "c1",
        "c2",
        "c3"
      ],
      "emphasize": [
        "claude",
        "meter"
      ],
      "set": {
        "claude": {
          "text": "Calling the three tools in turn.",
          "actions": [
            "get_account  name: \"Acme\"",
            "get_revenue  account: 4471  months: 12",
            "search_documents  query: \"Acme\""
          ]
        },
        "meter": {
          "used": 37,
          "items": [
            {
              "label": "CLAUDE.md",
              "share": "2%",
              "tone": "brief"
            },
            {
              "label": "account record: 80 raw fields",
              "share": "9%",
              "tone": "waste"
            },
            {
              "label": "12 months of revenue rows",
              "share": "14%",
              "tone": "waste"
            },
            {
              "label": "25 document matches",
              "share": "11%",
              "tone": "waste"
            },
            {
              "label": "your request",
              "share": "1%",
              "tone": "chat"
            }
          ]
        }
      }
    },
    {
      "id": "s3",
      "title": "Fold them behind one tool",
      "text": "A travel agent books the flight, hotel and car for you. An **outcome tool** does the same: one call, and the server's own code makes the three API calls in a fixed order, the same way every time. (A design choice, not something MCP requires.)",
      "show": [
        "you",
        "claude",
        "outcome",
        "t1",
        "t2",
        "t3"
      ],
      "connect": [
        "co",
        "o1",
        "o2",
        "o3"
      ],
      "emphasize": [
        "outcome"
      ],
      "dim": [
        "t1",
        "t2",
        "t3"
      ],
      "set": {
        "claude": {
          "text": "One call does it.",
          "actions": [
            "prepare_account_brief  account: \"Acme\""
          ]
        },
        "t1": {
          "kicker": "run by the server's code"
        },
        "t2": {
          "kicker": "run by the server's code"
        },
        "t3": {
          "kicker": "run by the server's code"
        }
      }
    },
    {
      "id": "s4",
      "title": "One call, one compact result",
      "text": "Back comes one short brief instead of three raw replies, so the desk stays clear for what only Claude does well: reading it and writing to Acme.",
