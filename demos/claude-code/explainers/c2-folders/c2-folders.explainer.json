              "name": "scripts",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "clean_invoices.sh",
              "depth": 1,
              "state": "dim"
            },
            {
              "name": "reports",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "2026-03_acme_summary.docx",
              "depth": 1,
              "state": "hit"
            }
          ]
        },
        "meter": {
          "used": 5,
          "items": [
            {
              "label": "find: 3 matching names",
              "share": "1%",
              "tone": "output"
            },
            {
              "label": "2026-03-31_acme_invoices.csv",
              "share": "3%",
              "tone": "file"
            },
            {
              "label": "your request",
              "share": "1%",
              "tone": "chat"
            }
          ]
        }
      }
    },
    {
      "id": "s7",
      "title": "Write the map down",
      "text": "Describe the layout in **CLAUDE.md**, which Claude reads at the start of every session, so it knows where things go before it opens anything. A **README.md** does the same job for people; Claude reads that only if it opens it.",
      "add": [
        "map"
      ],
      "emphasize": [
        "map"
      ],
      "dim": [
        "messy",
        "meter",
        "rule",
        "term"
      ],
      "set": {
        "tidy": {
          "items": [
            {
              "name": "README.md",
              "depth": 0,
              "state": "new",
              "note": "the map"
            },
            {
              "name": "CLAUDE.md",
              "depth": 0,
              "state": "new",
              "note": "the map"
            },
            {
              "name": "data",
              "kind": "folder",
