              "name": "2026-03-31_acme_invoices.csv",
              "depth": 2,
              "state": "plain"
            },
            {
              "name": "2026-03-31_bluebird_invoices.csv",
              "depth": 2
            },
            {
              "name": "clean",
              "kind": "folder",
              "depth": 1
            },
            {
              "name": "2026-03-31_acme_invoices.csv",
              "depth": 2,
              "state": "plain"
            },
            {
              "name": "scripts",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "clean_invoices.sh",
              "depth": 1
            },
            {
              "name": "reports",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "2026-03_acme_summary.docx",
              "depth": 1,
              "state": "plain"
            }
          ]
        }
      }
    },
    {
      "id": "s6",
      "title": "Names do the searching",
      "text": "Now a name says what's inside, so a search by name finds the right files without opening any. Claude Code on a Mac searches with exactly this kind of `find` command, and only the matches reach the desk.",
      "emphasize": [
        "term",
        "tidy",
        "meter"
      ],
      "dim": [
        "messy",
        "rule"
      ],
      "set": {
        "term": {
          "badge": "run by Claude",
          "lines": [
            {
              "kind": "cmd",
              "prompt": "Acme-reports %",
              "text": "find . -name \"*acme*\""
            },
            {
              "kind": "out",
              "text": "./data/clean/2026-03-31_acme_invoices.csv",
              "mark": true
            },
            {
              "kind": "out",
              "text": "./data/raw/2026-03-31_acme_invoices.csv",
              "mark": true
            },
            {
              "kind": "out",
              "text": "./reports/2026-03_acme_summary.docx",
              "mark": true
            }
          ]
        },
        "tidy": {
          "items": [
            {
              "name": "README.md",
              "depth": 0
            },
            {
              "name": "CLAUDE.md",
              "depth": 0
            },
            {
              "name": "data",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "raw",
