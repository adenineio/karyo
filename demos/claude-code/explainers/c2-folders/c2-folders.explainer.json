    {
      "id": "try",
      "type": "try-it",
      "props": {
        "title": "Ask for a plan first",
        "ask": "Suggest a folder structure for these files. Show me the plan; don't move anything yet.",
        "expect": "You get a proposed layout to read and adjust. Moving the files comes later, once you agree."
      },
      "at": {
        "x": 0,
        "y": 225,
        "w": 310
      }
