  "steps": [
    {
      "id": "s1",
      "title": "A junk drawer",
      "text": "A folder that grew by accident: three versions of the report, two `data` files, a scan named by the scanner. You might remember which is which. Claude, starting fresh, can't.",
      "show": [
        "messy"
      ],
      "emphasize": [
        "messy"
      ]
    },
    {
      "id": "s2",
      "title": "Claude opens everything",
      "text": "Ask for \"the March invoices for Acme\": no name gives a clue, and a plain-text search can't see inside Word and Excel files (they're zipped up), so Claude opens file after file. Everything it opens lands on its desk, the **context window**, and most of it is the wrong file.",
      "add": [
        "meter"
      ],
      "emphasize": [
        "meter"
      ],
      "set": {
        "meter": {
          "used": 50,
          "items": [
            {
              "label": "opened final_v2_REAL.docx",
              "share": "11%",
              "tone": "waste"
            },
            {
              "label": "opened data.csv",
              "share": "14%",
              "tone": "waste"
            },
            {
              "label": "opened data (1).csv",
              "share": "14%",
              "tone": "waste"
            },
            {
              "label": "opened Untitled (3).xlsx: found",
              "share": "9%",
              "tone": "file"
            },
            {
              "label": "your request",
              "share": "1%",
              "tone": "chat"
            }
          ]
        }
      }
    },
    {
      "id": "s3",
      "title": "A labelled cabinet",
      "text": "The same work, laid out like a labelled filing cabinet: a short note at the top, the data, the scripts, the reports. Structure is an instruction: it says where things are and where new things go.",
      "add": [
        "tidy"
      ],
      "emphasize": [
        "tidy"
      ],
      "dim": [
        "messy",
        "meter"
      ]
    },
    {
      "id": "s4",
      "title": "Raw stays raw",
      "text": "Keep the files you were given exactly as they arrived, and let **scripts** make everything else from them. The outputs are then deterministic: same input, same result, every time, and a mistake never reaches the originals.",
      "add": [
        "rule"
      ],
      "emphasize": [
        "rule",
        "tidy"
      ],
      "dim": [
        "messy",
        "meter"
      ],
      "set": {
        "tidy": {
          "items": [
            {
              "name": "README.md",
              "depth": 0
            },
            {
              "name": "CLAUDE.md",
              "depth": 0
            },
            {
              "name": "data",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "raw",
              "kind": "folder",
              "depth": 1,
              "note": "never edited",
              "state": "here"
            },
            {
              "name": "2026-03-31_acme_invoices.csv",
              "depth": 2,
              "state": "plain"
            },
            {
              "name": "2026-03-31_bluebird_invoices.csv",
              "depth": 2
            },
            {
              "name": "clean",
              "kind": "folder",
              "depth": 1,
              "note": "made by scripts"
            },
            {
              "name": "2026-03-31_acme_invoices.csv",
              "depth": 2,
              "state": "plain"
            },
            {
              "name": "scripts",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "clean_invoices.sh",
              "depth": 1
            },
            {
              "name": "reports",
              "kind": "folder",
              "depth": 0,
              "note": "made by scripts"
            },
            {
              "name": "2026-03_acme_summary.docx",
              "depth": 1,
              "state": "plain"
            }
          ]
        }
      }
    },
    {
      "id": "s5",
      "title": "Names that sort",
      "text": "Your computer sorts names letter by letter, so month names come out April, February, January (`ls -1` lists one name per line). Start each name with the date, year first, and the list sorts into time order by itself.",
      "add": [
        "term"
      ],
      "emphasize": [
        "term"
      ],
      "dim": [
        "messy",
        "meter",
        "tidy",
        "rule"
      ],
      "set": {
        "tidy": {
          "items": [
            {
              "name": "README.md",
              "depth": 0
            },
            {
              "name": "CLAUDE.md",
              "depth": 0
            },
            {
              "name": "data",
              "kind": "folder",
              "depth": 0
            },
            {
              "name": "raw",
              "kind": "folder",
              "depth": 1
            },
