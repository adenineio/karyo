  "steps": [
    {
      "id": "s1",
      "title": "A highlighter for files",
      "text": "Your notes are spread over a few folders and you need every mention of Acme. **grep** is a command that searches inside files and prints the lines that match: a highlighter run over every page at once, giving back only the highlighted lines.",
      "show": [
        "page",
        "tree"
      ]
    },
    {
      "id": "s2",
      "title": "Search one file",
      "text": "`grep \"Acme\" notes.txt` reads: find *Acme* in *notes.txt*. It prints only the two lines that contain it; the file itself is untouched.",
      "add": [
        "term"
      ],
      "emphasize": [
        "term",
        "page"
      ],
      "set": {
        "page": {
          "lines": [
            {
              "parts": [
                {
                  "t": "Call "
                },
                {
                  "t": "Acme",
                  "mark": "hit"
                },
                {
                  "t": " on Friday about the renewal."
                }
              ],
              "state": "lit"
            },
            {
              "parts": [
                {
                  "t": "Lunch with Priya on Tuesday."
                }
              ],
              "state": "dim"
            },
            {
              "parts": [
                {
                  "t": "Send ACME the signed contract."
                }
              ],
              "state": "dim"
            },
            {
              "parts": [
                {
                  "t": "Acme",
                  "mark": "hit"
                },
                {
                  "t": " Corp wants the Q3 report early."
                }
              ],
              "state": "lit"
            },
            {
              "parts": [
                {
                  "t": "Rent a vehicle for the Denver trip."
                }
              ],
              "state": "dim"
            }
          ],
          "note": "2 matching lines"
        }
      }
    },
    {
      "id": "s3",
      "title": "Search every folder",
      "text": "Add `-r` and give it `.` (*the folder you're in*) instead of one file: grep searches every file in every folder inside. Each line now starts with the file it came from.",
      "add": [
        "opts"
      ],
      "emphasize": [
        "term",
        "tree"
      ],
      "set": {
        "term": {
          "lines": [
            {
              "kind": "cmd",
              "text": "grep -r \"Acme\" ."
            },
            {
              "kind": "out",
              "text": "./Clients/acme.txt:Client: Acme, Inc."
            },
            {
              "kind": "out",
              "text": "./Clients/globex.txt:Referred to us by Acme."
            },
            {
              "kind": "out",
              "text": "./notes.txt:Call Acme on Friday about the renewal."
            },
            {
              "kind": "out",
              "text": "./notes.txt:Acme Corp wants the Q3 report early."
            }
          ]
        },
