{
  "name": "callout",
  "description": "A note, warning or confirmation set apart from the rest: a coloured edge, optional title, markdown-lite.",
  "version": "1.0.0",
  "props": {
    "type": "object",
    "required": ["md"],
    "additionalProperties": false,
    "properties": {
      "md": { "type": "string", "description": "markdown-lite" },
      "tone": { "enum": ["note", "warn", "ok"], "default": "note" },
      "title": { "type": "string" }
    }
  },
  "size": { "w": 340 },
  "motion": ["appear", "emphasize"],
  "example": { "tone": "warn", "title": "Watch out", "md": "Fees compound too." }
}
