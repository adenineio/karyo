{
  "name": "kv",
  "description": "Key/value pairs (a definition list), with an optional title.",
  "version": "1.0.0",
  "props": {
    "type": "object",
    "required": ["pairs"],
    "additionalProperties": false,
    "properties": {
      "title": { "type": "string" },
      "pairs": {
        "type": "array", "minItems": 1,
        "items": { "type": "object", "required": ["k", "v"], "additionalProperties": false, "properties": { "k": { "type": "string" }, "v": { "type": ["string", "number", "boolean"] } } }
      }
    }
  },
  "size": { "w": 300 },
  "motion": ["appear", "emphasize"],
  "example": { "title": "Inputs", "pairs": [{ "k": "principal", "v": "$1,000" }, { "k": "rate", "v": "5%" }] }
}
